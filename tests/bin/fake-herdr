#!/usr/bin/env python3
"""A stand-in for the herdr CLI in the tests of Vision. Standard library only.

The session name is the folder of its state: `herdr --session <folder> <command>`. It knows the
commands that Vision runs: workspace list, create, and focus; tab create, rename, close, and
focus; pane run (the line runs in the background in the folder of the tab, and the file
.fake-herdr-typed there names the file of the typed text of the pane); agent prompt (the text
goes to that file); agent send-keys (down and enter answer a folder dialog in the file
<pane>.screen); pane read (that file). Each call goes to calls.jsonl.
"""
import json
import os
import subprocess
import sys


def main():
    argv = sys.argv[1:]
    if len(argv) < 2 or argv[0] != "--session":
        print(json.dumps({"error": {"code": "usage", "message": "no session"}}))
        return 1
    state = argv[1]
    args = argv[2:]
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "calls.jsonl"), "a") as f:
        f.write(json.dumps(args) + "\n")
    if os.path.exists(os.path.join(state, "down")):
        print(json.dumps({"error": {"code": "server_not_running", "message": "no server"}}))
        return 1
    db_path = os.path.join(state, "db.json")
    db = json.load(open(db_path)) if os.path.exists(db_path) else {"workspaces": [], "n": 0}

    def opt(name):
        return args[args.index(name) + 1] if name in args else None

    def save():
        json.dump(db, open(db_path, "w"))

    def ok(result):
        print(json.dumps({"id": "cli", "result": result}))
        return 0

    cmd = args[:2]
    if cmd == ["workspace", "list"]:
        return ok({"type": "workspace_list", "workspaces": [
            {"workspace_id": w["id"], "label": w["label"]} for w in db["workspaces"]]})
    if cmd == ["workspace", "create"]:
        db["n"] += 1
        w = {"id": "w%d" % db["n"], "label": opt("--label"), "tabs": []}
        db["workspaces"].append(w)
        db["n"] += 1
        tab = "%s:t%d" % (w["id"], db["n"])
        w["tabs"].append({"id": tab, "label": "1", "pane": tab + ":p", "cwd": opt("--cwd")})
        save()
        return ok({"type": "workspace_created", "workspace": {"workspace_id": w["id"]},
                   "tab": {"tab_id": tab}, "root_pane": {"pane_id": tab + ":p"}})
    if cmd == ["tab", "create"]:
        w = next(w for w in db["workspaces"] if w["id"] == opt("--workspace"))
        db["n"] += 1
        tab = "%s:t%d" % (w["id"], db["n"])
        w["tabs"].append({"id": tab, "label": opt("--label"), "pane": tab + ":p", "cwd": opt("--cwd")})
        save()
        return ok({"type": "tab_created", "tab": {"tab_id": tab}, "root_pane": {"pane_id": tab + ":p"}})
    if cmd == ["tab", "rename"]:
        for w in db["workspaces"]:
            for t in w["tabs"]:
                if t["id"] == args[2]:
                    t["label"] = args[3]
        save()
        return ok({"type": "ok"})
    if cmd == ["tab", "close"]:
        for w in db["workspaces"]:
            w["tabs"] = [t for t in w["tabs"] if t["id"] != args[2]]
        save()
        return ok({"type": "ok"})
    if cmd == ["tab", "focus"]:
        return ok({"type": "ok"})
    if cmd == ["workspace", "focus"]:
        return ok({"type": "ok"})
    if cmd == ["pane", "run"]:
        pane, line = args[2], args[3]
        cwd = next((t["cwd"] for w in db["workspaces"] for t in w["tabs"] if t["pane"] == pane), None)
        typed = os.path.join(state, pane.replace(":", "_") + ".typed")
        # The session clears its environment, so the pane tells it the file in its folder.
        if cwd:
            with open(os.path.join(cwd, ".fake-herdr-typed"), "w") as f:
                f.write(typed)
        log = open(os.path.join(state, pane.replace(":", "_") + ".log"), "a")
        subprocess.Popen(["/bin/sh", "-c", line], cwd=cwd, stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True)
        return ok({"type": "ok"})
    if cmd == ["agent", "prompt"]:
        pane, text = args[2], args[3]
        with open(os.path.join(state, pane.replace(":", "_") + ".typed"), "a") as f:
            f.write(text + "\n")
        return ok({"type": "ok"})
    if cmd == ["agent", "send-keys"]:
        # A folder dialog of the fake claude on the screen: down moves the selection, enter
        # answers with the selected option.
        path = os.path.join(state, args[2].replace(":", "_") + ".screen")
        for k in args[3:]:
            screen = open(path).read() if os.path.exists(path) else ""
            if k == "down" and "\u276f No, exit" in screen:
                screen = screen.replace("\u276f No, exit\n   Yes", "  No, exit\n \u276f Yes")
            elif k == "enter" and "Enter to confirm" in screen:
                screen = "accepted" if "\u276f Yes" in screen else "refused"
            open(path, "w").write(screen)
        return ok({"type": "ok"})
    if cmd == ["pane", "read"]:
        path = os.path.join(state, args[2].replace(":", "_") + ".screen")
        sys.stdout.write(open(path).read() if os.path.exists(path) else "")
        return 0
    print(json.dumps({"error": {"code": "unknown", "message": " ".join(args)}}))
    return 1


if __name__ == "__main__":
    sys.exit(main())
