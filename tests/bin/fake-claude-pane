#!/usr/bin/env python3
"""A stand-in for an interactive Claude Code session in a herdr pane, for the tests of Vision.
Standard library only. fake-claude runs it when the start line has no -p.

It reads --settings (the hooks), --session-id, --permission-mode, and the first prompt (the
last argument). It writes a transcript to $HOME/fake-transcripts/<session>.jsonl and runs the
hooks with the input that Claude Code gives them. The first prompt names the facts file of the
turn; `fake.pane` there is a list of replies. Each prompt, the first one and each one that
fake-herdr types into the pane (the file that .fake-herdr-typed names), takes the next reply: an object with "message", the last
assistant message, and an optional "sleep" in seconds before it. The prompt "/exit" ends the
session with the hook SessionEnd. With no reply left, the session waits for the next prompt.
A reply {"fail": "<error>"} runs the hook StopFailure instead of Stop.
"""
import json
import os
import re
import subprocess
import sys
import time


def arg(argv, name):
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
    return None


def main():
    argv = sys.argv[1:]
    settings = json.load(open(arg(argv, "--settings")))
    session = arg(argv, "--session-id") or arg(argv, "--resume")
    mode = arg(argv, "--permission-mode")
    model = arg(argv, "--model")
    first = argv[-1]
    home = os.environ.get("HOME", "/tmp")
    folder = os.path.join(home, "fake-transcripts")
    os.makedirs(folder, exist_ok=True)
    transcript = os.path.join(folder, session + ".jsonl")
    hooks = settings.get("hooks", {})

    def hook(event, extra):
        data = {"session_id": session, "transcript_path": transcript, "cwd": os.getcwd(),
                "hook_event_name": event}
        data.update(extra)
        for entry in hooks.get(event, []):
            for h in entry.get("hooks", []):
                subprocess.run(h["command"], shell=True, input=json.dumps(data).encode())

    def write(line):
        with open(transcript, "a") as f:
            f.write(json.dumps(line) + "\n")

    m = re.search(r"\.vision/turns/([^/]+)/facts\.json", first)
    facts = json.load(open(os.path.join(".vision", "turns", m.group(1), "facts.json"))) if m else {}
    replies = list(facts.get("fake", {}).get("pane", []))
    status = settings.get("statusLine", {}).get("command")
    hook("SessionStart", {"source": "startup", "model": model})
    typed_file = open(".fake-herdr-typed").read().strip() if os.path.exists(".fake-herdr-typed") else None
    pending = [first]
    seen = 0
    n = 0
    while True:
        if not pending:
            if typed_file and os.path.exists(typed_file):
                lines = open(typed_file).read().splitlines()
                pending.extend(lines[seen:])
                seen = len(lines)
            if not pending:
                time.sleep(0.1)
                continue
        prompt = pending.pop(0)
        if prompt == "/exit":
            hook("SessionEnd", {"reason": "prompt_input_exit"})
            return 0
        hook("UserPromptSubmit", {"prompt": prompt, "permission_mode": mode})
        write({"type": "user", "message": {"role": "user", "content": prompt}})
        if not replies:
            continue
        reply = replies.pop(0)
        time.sleep(reply.get("sleep", 0))
        if "fail" in reply:
            hook("StopFailure", {"error": reply["fail"], "last_assistant_message": reply.get("message", "")})
            continue
        n += 1
        message = reply["message"]
        write({"type": "assistant", "message": {"id": "msg-%d" % n, "role": "assistant",
               "content": [{"type": "text", "text": message}],
               "usage": {"input_tokens": 1, "cache_creation_input_tokens": 2,
                         "cache_read_input_tokens": 3, "output_tokens": 4}}})
        if status:
            subprocess.run(status, shell=True, input=json.dumps({"session_id": session, "cost": {"total_cost_usd": 0.05 * n}}).encode(), stdout=subprocess.DEVNULL)
        hook("Stop", {"last_assistant_message": message, "stop_hook_active": False})


if __name__ == "__main__":
    sys.exit(main())
