#!/usr/bin/env python3
"""bin/app-token of the adapter jira-github: prints an installation token of a GitHub App.

    app-token --app-id ID --installation-id ID (--key-file PATH | --key-command CMD) [--api URL]
"""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from jgadapter import app_token  # noqa: E402

if __name__ == "__main__":
    sys.exit(app_token.main())
