#!/usr/bin/env python3
"""bin/act of the adapter jira-github: runs one verb, or answers a reconcile or a read verb (design section 11.1)."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from jgadapter import core, act as script  # noqa: E402

if __name__ == "__main__":
    core.main(script.act)
