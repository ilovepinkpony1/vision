#!/usr/bin/env python3
"""bin/observe of the demo adapter: the facts of the queue or of one ticket (design section 11.1)."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import demo_world  # noqa: E402

if __name__ == "__main__":
    demo_world.main(demo_world.observe)
